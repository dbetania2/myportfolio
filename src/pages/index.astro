---
import WindowController from '../components/WindowController.jsx';
import Character from '../components/character/Character.astro';


// variable para la url de la api de strapi
const API_URL = import.meta.env.PUBLIC_STRAPI_API_URL;


// se realizan peticiones a la api en paralelo para mejorar el rendimiento
const [resAbout, resProjects, resSections] = await Promise.all([
  fetch(`${API_URL}/about-me?populate=profile_picture,SocialLink,skills,biography_blocks,biography_blocks.image`),
  fetch(`${API_URL}/projects?populate=featured_image,tags,gallery`),
  fetch(`${API_URL}/project-sections?populate=tags`)
]);

// se maneja la respuesta de las peticiones de manera robusta
const aboutData = resAbout.ok ? await resAbout.json() : { data: null };
const projectsData = resProjects.ok ? await resProjects.json() : { data: [] };
const sectionsData = resSections.ok ? await resSections.json() : { data: [] };



// se extraen los datos de las respuestas para ser pasados a los componentes
const aboutMeData = aboutData.data;
const projectsAllData = projectsData.data;
---

<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Mi Portfolio</title>
 <link rel="stylesheet" href="/src/styles/index.css">
</head>
<body>
 <div id="welcome-screen">
   <div id="welcome-text">
     <div class="word"><span>W</span><span>e</span><span>l</span><span>c</span><span>o</span><span>m</span><span>e</span></div>
     <div class="word"><span>t</span><span>o</span></div>
     <div class="word"><span>m</span><span>y</span></div>
     <div class="word"><span>p</span><span>o</span><span>r</span><span>t</span><span>f</span><span>o</span><span>l</span><span>i</span><span>o</span></div>
   </div>
 </div>


 <div id="map-container">
   <img src="/assets/portflioactualizado2.png" alt="Mapa" id="map-image">
   <canvas id="gameCanvas"></canvas> 


 <WindowController
    client:load
    aboutMeData={aboutMeData}
    projectsData={projectsAllData}
    sectionsData={sectionsData.data}
  />



 <div id="root"></div>
 <Character />
 </div>


 <script type="module" src="/src/main.jsx"></script>
</body>
</html>